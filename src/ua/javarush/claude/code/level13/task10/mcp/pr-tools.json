{
  "name": "pr-tools",
  "description": "MCP-сервер для читання pull request (diff + коментарі), лише read-only",
  "transport": "http",
  "url": "https://git.internal.example/mcp",
  "authScopes": [
    "repo:read"
  ],
  "tools": [
    "get_diff",
    "list_comments"
  ],
  "limits": {
    "maxResults": 50,
    "pageSize": 25,
    "fields": ["id", "title", "status", "author", "createdAt", "diff", "comments"]
  }
}