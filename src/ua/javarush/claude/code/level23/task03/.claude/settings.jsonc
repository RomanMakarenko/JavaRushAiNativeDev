{
  // Політика проєкту для Workflow Kit (Commerce OS).
  // TODO: поточний baseline надто м'який — Edit в allow, protected paths не захищені.
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(./gradlew test*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git commit*)"
    ],
    "deny": [
      "Edit(./payments/**)",
      "Edit(./migrations/**)",
      "Edit(./.env*)",
      "Bash(git push --force*)",
      "Bash(rm -rf*)"
    ]
  }
}